@prefix dcterms: <http://purl.org/dc/terms#> .
@base <http://purl.org/spatialai/cg/cg-top-level#> .

<http://purl.org/spatialai/cg/cg-top-level> rdf:type owl:Ontology ;
                                            owl:versionIRI <http://purl.org/spatialai/onner/v1/onner-full> ;
                                            dcterms:bibliographicCitation "Umayer Reza, Torsten Hahmann. (2026). Cellulosic Materials Top Level Domain Ontology." ;
                                            dcterms:created "2025-12-05"^^xsd:date ;
                                            dcterms:creator "Umayer Reza <https://orcid.org/0000-0003-4013-3513>"@en ,
                                            				"Torsten Hahmann <http://orcid.org/0000-0002-5331-5052>"@en ;
                                            dcterms:description "Top level domain ontology for cellulosic entities."@en ;
                                            dcterms:identifier <http://purl.org/spatialai/onner/onner-full> ;
                                            dcterms:issued "2000-00-00"^^xsd:date ;
                                            dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                            dcterms:modified "2000-00-00"^^xsd:date ;
                                            dcterms:publisher "Spatial Knowledge and Artificial Intelligence (SKAI) Lab, University of Maine"@en ;
                                            dcterms:source <http://example.com/source> ;
                                            dcterms:subject "Cellulosic Entities" ,
                                            				"Top Level Domain Ontology" ;
                                            dcterms:title "Cellulosic Materials Top Level Domain Ontology"@en ;
                                            bibo:doi "NA" ;
                                            bibo:status "stable" ;
                                            owl:versionInfo "1.0"@en ;
                                            foaf:logo <http://example.com/ontology_logo.png> .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo#BFO_0000001
<http://purl.obolibrary.org/obo#BFO_0000001> rdf:type owl:Class ;
                                             rdfs:comment "An entity is anything that exists or has existed or will exist."@en ;
                                             rdfs:label "Entity"@en .


###  http://purl.obolibrary.org/obo#BFO_0000002
<http://purl.obolibrary.org/obo#BFO_0000002> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000001> ;
                                             rdfs:comment "A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity."@en ;
                                             rdfs:label "Continuant"@en .


###  http://purl.obolibrary.org/obo#BFO_0000004
<http://purl.obolibrary.org/obo#BFO_0000004> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000002> ;
                                             rdfs:comment "B is an independent continuant = Def. B is a continuant which is such that there is no C and no T such that B s-depends_on C at T."@en ;
                                             rdfs:label "Independent Continuant"@en .


###  http://purl.obolibrary.org/obo#BFO_0000040
<http://purl.obolibrary.org/obo#BFO_0000040> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000004> ;
                                             rdfs:comment "A material entity is an independent continuant that has some portion of matter as proper or improper continuant part."@en ;
                                             rdfs:label "Material Entity"@en .

# Classes for secondary taxonomy
# =================================================================
### http://purl.org/spatialai/cg/cg-top-level#MacroscopicMaterialEntity
cg:MacroscopicMaterialEntity rdf:type owl:Class ;
                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000040> ;
                             rdfs:comment ""@en ;
                             rdfs:label "Macroscopic Material Entity"@en .


### http://purl.org/spatialai/cg/cg-top-level#MicroscopicMaterialEntity
cg:MicroscopicMaterialEntity rdf:type owl:Class ;
                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000040> ;
                             rdfs:comment ""@en ;
                             rdfs:label "Microscopic Material Entity"@en .
# =================================================================


###  http://purl.obolibrary.org/obo#BFO_0000024
<http://purl.obolibrary.org/obo#BFO_0000024> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000040> ;
                                             rdfs:comment ""@en ;
                                             rdfs:label "Fiat Object Part"@en .


### http://purl.org/spatialai/cg/cg-top-level#MacroscopicFiatObjectPart
cg:MacroscopicFiatObjectPart rdf:type owl:Class ;
                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000024> ,
                             				 cg:MacroscopicMaterialEntity ;
                             rdfs:comment ""@en ;
                             rdfs:label "Macroscopic Fiat Object Part"@en .
 

### http://purl.org/spatialai/cg/cg-top-level#MacroscopicMaterialNon-StructurePart
cg:MacroscopicMaterialNon-StructurePart rdf:type owl:Class ;
						                rdfs:subClassOf cg:MacroscopicFiatObjectPart ;
						                rdfs:comment ""@en ;
						                rdfs:label "Macroscopic Material Non-Structure Part"@en .
                             
                                                   
### http://purl.org/spatialai/cg/cg-top-level#MicroscopicFiatObjectPart
cg:MicroscopicFiatObjectPart rdf:type owl:Class ;
                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000024> ,
                             				 cg:MicroscopicMaterialEntity ;
                             rdfs:comment ""@en ;
                             rdfs:label "Microscopic Fiat Object Part"@en .


### http://purl.org/spatialai/cg/cg-top-level#MicroscopicChemicalNonStructurePart
cg:MicroscopicChemicalNon-StructurePart rdf:type owl:Class ;
				                        rdfs:subClassOf cg:MicroscopicFiatObjectPart ;
				                        rdfs:comment ""@en ;
				                        rdfs:label "Microscopic Chemical Non-Structure Part"@en .
                             
                             
### http://purl.org/spatialai/cg/cg-top-level#MicroscopicChemicalStructurePart
cg:MicroscopicChemicalStructurePart rdf:type owl:Class ;
		                            rdfs:subClassOf cg:MicroscopicFiatObjectPart ;
		                            rdfs:comment ""@en ;
		                            rdfs:label "Microscopic Chemical Structure Part"@en .


###  http://purl.obolibrary.org/obo#BFO_0000030
<http://purl.obolibrary.org/obo#BFO_0000030> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000040> ;
                                             rdfs:comment ""@en ;
                                             rdfs:label "Object"@en .
                                             
                                             
### http://purl.org/spatialai/cg/cg-top-level#MacroscopicObject
cg:MacroscopicObject rdf:type owl:Class ;
                     rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000030> ,
                     				 cg:MacroscopicMaterialEntity ;
                     rdfs:comment ""@en ;
                     rdfs:label "Macroscopic Object"@en .


### http://purl.org/spatialai/cg/cg-top-level#StructuredMaterialObject
cg:StructuredMaterialObject rdf:type owl:Class ;
                            rdfs:subClassOf cg:MacroscopicObject ;
                            rdfs:comment ""@en ;
                            rdfs:label "Structured Material Object"@en .


### http://purl.org/spatialai/cg/cg-top-level#Equipment
cg:Equipment rdf:type owl:Class ;
             rdfs:subClassOf cg:MacroscopicObject ;
             rdfs:comment ""@en ;
             rdfs:label "Equipment"@en .


### http://purl.org/spatialai/cg/cg-top-level#MaterialProduct
cg:MaterialProduct rdf:type owl:Class ;
                   rdfs:subClassOf cg:MacroscopicObject ;
                   rdfs:comment ""@en ;
                   rdfs:label "Material Product"@en .
                             

### http://purl.org/spatialai/cg/cg-top-level#MicroscopicObject
cg:MicroscopicObject rdf:type owl:Class ;
		             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000030> ,
		             				 cg:MicroscopicMaterialEntity ;
		             rdfs:comment ""@en ;
		             rdfs:label "Microscopic Object"@en .


### http://purl.org/spatialai/cg/cg-top-level#ChemicalEntity
cg:ChemicalEntity rdf:type owl:Class ;
                  rdfs:subClassOf cg:MicroscopicObject ;
                  rdfs:comment ""@en ;
                  rdfs:label "Chemical Entity"@en .


### http://purl.org/spatialai/cg/cg-top-level#ChemicalPart
cg:ChemicalPart rdf:type owl:Class ;
                rdfs:subClassOf cg:MicroscopicObject ;
                rdfs:comment ""@en ;
                rdfs:label "Chemical Part"@en .
                                             
                                                          
###  http://purl.obolibrary.org/obo#BFO_0000020
<http://purl.obolibrary.org/obo#BFO_0000020> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000002> ;
                                             rdfs:comment "B is a specifically dependent continuant = Def. B is a continuant & there is some independent continuant C which is not a spatial region and which is such that B s-depends_on C at every time T during the course of B’s existence."@en ;
                                             rdfs:label "Specifically Dependent Continuant"@en .                                 


###  http://purl.obolibrary.org/obo#BFO_0000019
<http://purl.obolibrary.org/obo#BFO_0000019> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000020> ;
                                             rdfs:comment "A quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized."@en ;
                                             rdfs:label "Quality"@en .
                                             

### http://purl.org/spatialai/cg/cg-top-level#MaterialQuality
cg:MaterialQuality rdf:type owl:Class ;
                   rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000019> ;
                   rdfs:comment ""@en ;
                   rdfs:label "Material Quality"@en .
                                             

### http://purl.org/spatialai/cg/cg-top-level#NonstructuralMaterialQuality
cg:NonstructuralMaterialQuality rdf:type owl:Class ;
                                rdfs:subClassOf cg:MaterialQuality ;
                                rdfs:comment ""@en ;
                                rdfs:label "Nonstructural Material Quality"@en .


### http://purl.org/spatialai/cg/cg-top-level#StructureQuality
cg:StructureQuality rdf:type owl:Class ;
                    rdfs:subClassOf cg:MaterialQuality ;
                    rdfs:comment ""@en ;
                    rdfs:label "Structure Quality"@en .


###  http://purl.obolibrary.org/obo#BFO_0000017
<http://purl.obolibrary.org/obo#BFO_0000017> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000020> ;
                                             rdfs:comment "To say that B is a realizable entity is to say that B is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type."@en ;
                                             rdfs:label "Realizable Entity"@en .


###  http://purl.obolibrary.org/obo#BFO_0000016
<http://purl.obolibrary.org/obo#BFO_0000016> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000017> ;
                                             rdfs:comment ""@en ;
                                             rdfs:label "Disposition"@en .


###  http://purl.obolibrary.org/obo#BFO_0000034
<http://purl.obolibrary.org/obo#BFO_0000034> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000016> ;
                                             rdfs:comment ""@en ;
                                             rdfs:label "Function"@en .


###  http://purl.obolibrary.org/obo#BFO_0000031
<http://purl.obolibrary.org/obo#BFO_0000031> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000002> ;
                                             rdfs:comment "B is a generically dependent continuant = Def. B is a continuant that g-depends_on one or more other entities."@en ;
                                             rdfs:label "Generically Dependent Continuant"@en .
                                             
                                             
 ###  http://purl.obolibrary.org/obo#IAO_0000030
<http://purl.obolibrary.org/obo#IAO_0000030> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000031> ;
                                             rdfs:comment "A generically dependent continuant that is about some thing."@en ;
                                             rdfs:label "Information Content Entity"@en .                                            


 ###  http://purl.obolibrary.org/obo#IAO_0000027
<http://purl.obolibrary.org/obo#IAO_0000027> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#IAO_0000030> ;
                                             rdfs:comment ""@en ;
                                             rdfs:label "Data Item"@en .     


 ###  http://purl.obolibrary.org/obo#IAO_0000109
<http://purl.obolibrary.org/obo#IAO_0000109> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#IAO_0000027> ;
                                             rdfs:comment ""@en ;
                                             rdfs:label "Measurement Datum" .  
                                             
                                             
### http://purl.org/spatialai/cg/cg-top-level#Measurement
cg:Measurement rdf:type owl:Class ;
               rdfs:subClassOf <http://purl.obolibrary.org/obo#IAO_0000109> ;
               rdfs:comment ""@en ;
               rdfs:label "Measurement"@en .
                             
                             
###  http://purl.obolibrary.org/obo#BFO_0000003
<http://purl.obolibrary.org/obo#BFO_0000003> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000001> ;
                                             rdfs:comment "An occurrent is an entity that unfolds itself in time or it is the instantaneous boundary of such an entity (for example a beginning or an ending) or it is a temporal or spatiotemporal region which such an entity occupies_temporal_region or occupies_spatiotemporal_region."@en ;
                                             rdfs:label "Occurrent"@en .                                             


###  http://purl.obolibrary.org/obo#BFO_0000015
<http://purl.obolibrary.org/obo#BFO_0000015> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000003> ;
                                             rdfs:comment "P is a process = Def. P is an occurrent that has temporal proper parts and for some time T, P s-depends_on some material entity at T."@en ;
                                             rdfs:label "Process"@en .


### http://purl.org/spatialai/cg/cg-top-level#Process
cg:Process rdf:type owl:Class ;
           rdfs:subClassOf <http://purl.obolibrary.org/obo#BFO_0000015> ;
           rdfs:comment ""@en ;
           rdfs:label "Process"@en .


